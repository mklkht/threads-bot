# Секрети threads-bot. Скопіюй у .env і заповни — цей файл у git не потрапляє (.gitignore).
# Несекретні налаштування (розклад, персона, ліміти) — у config.env, він уже в git.

# Long-lived user access token з Meta developer app (Threads API, scopes: threads_basic,
# threads_content_publish, threads_read_replies, threads_manage_replies)
THREADS_ACCESS_TOKEN=REPLACE_ME

LLM_API_KEY=REPLACE_ME

# ---- Алерти в Telegram (необов'язково) ----
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
