# Несекретні налаштування threads-bot. Цей файл у git — секрети (токени, ключі) сюди не пишемо, вони в .env.
# config.env читається ПІСЛЯ .env і має пріоритет над ним (app/config.py).

# ---- Threads API ----
THREADS_API_BASE=https://graph.threads.net/v1.0

# ---- LLM ----
LLM_PROVIDER=gemini
# Модель для генерації постів (сильніша, краща якість українського тексту)
LLM_MODEL_POST=gemini-2.5-flash
# Модель для класифікації коментарів (дешевша, швидша)
LLM_MODEL_CLASSIFY=gemini-2.5-flash-lite

# ---- Персона акаунта ----
ACCOUNT_PERSONA=Людина близько 30. Не про роботу і не про технології. Говорить як голосове: коротко, трохи несправедливо, можна обірвати фразу. Без моралі і без вилизаного тексту. Одна гостра думка, в якій хтось упізнає себе. Не лише філософія: статус, гроші, сім'я, закоханість, вік. Не лекція і не побутова замальовка. Іноді, приблизно один пост із трьох-чотирьох і не підряд, можна сарказм і грубість, включно з лайкою. Не в кожному пості. Не в конкретну живу людину на ім'я.
# Теми через ";" — запасний кут, якщо чуже спостереження не відкрилось. Не новини.
NICHE_TOPICS=чужа гордість, яку в Україні видно з першого речення;гроші, якими людина закриває щось інше;сім'я, де всі ввічливі і ніхто не каже правду;закоханість, у якій хтось уже програв і робить вигляд;вік, який помічаєш не в дзеркалі;статус, який тримається на одній звичці
# Перед чернеткою без ідеї автора: чужий заголовок з іншого місця і один локальний хід.
SPARK_FETCH=true

# ---- Розклад і ліміти постів ----
# О 09:30 і 19:30 бот сам надсилає чернетку в Telegram. У Threads пост іде лише з кнопки.
POST_CRON=30 9,19 * * *
POST_JITTER_SEC=1200
POST_MAX_CHARS=400

# ---- Відповіді на коментарі ----
REPLIES_INTERVAL_MIN=10
REPLIES_POSTS_LIMIT=5
REPLIES_MAX_PER_CYCLE=10
REPLIES_MAX_PER_USER=2
REPLY_DELAY_MIN_SEC=15
REPLY_DELAY_MAX_SEC=45
REPLY_MAX_CHARS=250

# ---- Служове ----
TOKEN_REFRESH_DAYS=25
# false: пости й відповіді публікуються. Поверни true, щоб знову лише писати в лог.
DRY_RUN=false
DB_PATH=/app/data/bot.db
LOG_LEVEL=INFO
