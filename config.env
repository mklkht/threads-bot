# Несекретні налаштування threads-bot. Цей файл у git — секрети (токени, ключі) сюди не пишемо, вони в .env.
# config.env читається ПІСЛЯ .env і має пріоритет над ним (app/config.py).

# ---- Threads API ----
THREADS_API_BASE=https://graph.threads.net/v1.0

# ---- LLM ----
LLM_PROVIDER=gemini
# Модель для генерації постів (сильніша, краща якість українського тексту)
LLM_MODEL_POST=gemini-2.5-flash
# Модель для класифікації коментарів (дешевша, швидша)
LLM_MODEL_CLASSIFY=gemini-2.5-flash-lite

# ---- Персона акаунта ----
ACCOUNT_PERSONA=Людина близько 30. Не про роботу і не про технології. Говорить як голосове: коротко, трохи несправедливо, можна обірвати фразу. Без моралі і без вилизаного тексту. Одна гостра думка, в якій хтось упізнає себе. Не лекція і не побутова замальовка.
# Теми через ";" — кут для однієї думки, якщо автор не дав ідеї. Не новини і не побутові сценки.
NICHE_TOPICS=звичка, яку людина захищає як свій характер;історія про себе, під якою друг би не підписався;як люди показують, що в них усе добре;гроші як спосіб не сказати, чого насправді хочеш;думка, яку приміряєш на себе і вона сідає занадто добре

# ---- Розклад і ліміти постів ----
# О 09:30 і 19:30 бот сам надсилає чернетку в Telegram. У Threads пост іде лише з кнопки.
POST_CRON=30 9,19 * * *
POST_JITTER_SEC=1200
POST_MAX_CHARS=400

# ---- Відповіді на коментарі ----
REPLIES_INTERVAL_MIN=10
REPLIES_POSTS_LIMIT=5
REPLIES_MAX_PER_CYCLE=10
REPLIES_MAX_PER_USER=2
REPLY_DELAY_MIN_SEC=15
REPLY_DELAY_MAX_SEC=45
REPLY_MAX_CHARS=250

# ---- Служове ----
TOKEN_REFRESH_DAYS=25
# false: пости й відповіді публікуються. Поверни true, щоб знову лише писати в лог.
DRY_RUN=false
DB_PATH=/app/data/bot.db
LOG_LEVEL=INFO
